{
  "name": "kreon-regpulse",
  "version": "1.0.0",
  "description": "Unified register of RBI compliance updates (notifications, circulars) for CS/compliance teams.",
  "type": "module",
  "scripts": {
    "fetch:rbi-md": "node scripts/fetch-master-directions.mjs",
    "fetch:rbi-notif": "node scripts/fetch-rbi-notifications.mjs",
    "fetch:sebi-reg": "node scripts/fetch-sebi-regulations.mjs",
    "fetch:sebi-circ": "node scripts/fetch-sebi-circulars.mjs",
    "fetch:acts": "node scripts/fetch-acts-rules.mjs",
    "fetch:secstandards": "node scripts/fetch-secretarial-standards.mjs",
    "fetch": "node scripts/fetch-all.mjs",
    "fetch:live": "node scripts/fetch-all.mjs --live-only",
    "fetch:monthly": "node scripts/fetch-monthly.mjs",
    "watch": "node scripts/watch-realtime.mjs",
    "digest:monthly": "node scripts/send-monthly-digest.mjs",
    "serve": "npx serve .",
    "start": "npm run fetch && npx serve ."
  },
  "license": "MIT",
  "dependencies": {
    "fast-xml-parser": "^5.10.0",
    "nodemailer": "^9.0.3",
    "proper-lockfile": "^4.1.2"
  }
}
