# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.
#
# Used by: scripts/email-notifier.mjs, scripts/send-monthly-digest.mjs,
# scripts/watch-realtime.mjs (loaded automatically from the project root).
# The same names are set as GitHub Actions secrets for the CI workflows in
# .github/workflows/ (Settings → Secrets and variables → Actions on GitHub) —
# this file is only for running the scripts locally.

# --- SMTP (required to actually send mail; scripts log a warning and skip
#     sending if these are missing) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Kreon RegPulse" <alerts@yourdomain.com>

# --- Recipient overrides (optional) ---
# Each is a comma-separated list of email addresses. If left unset, recipients
# fall back to config/recipients.json (csTeam / ceo / devOps / default).
EMAIL_RECIPIENTS=
CS_TEAM_RECIPIENTS=
CEO_RECIPIENTS=
DEV_OPS_RECIPIENTS=

# --- Who sends alert emails (optional) ---
# Alerts and digests are sent by the GitHub Action only. Set to 1 to send from this
# machine instead, and then remove the SMTP secrets from the GitHub workflows so the
# same release isn't emailed twice.
ALERTS_FROM_THIS_MACHINE=

# --- Real-time watcher tuning (optional, scripts/watch-realtime.mjs) ---
POLL_INTERVAL_MS=
ACTIVE_HOURS_START=
ACTIVE_HOURS_END=
